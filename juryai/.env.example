# JuryAI local LLM routing (decoupled, sovereign). Copy to .env to override.
# Any OpenAI-compatible server: vLLM (http://localhost:8000/v1), Ollama (http://localhost:11434/v1), LM Studio.
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=mock-key
LOCAL_LLM_MODEL=vllm-local-model
LOCAL_LLM_TIMEOUT=8.0
# Optional persistence. Omit MONGO_URL to use the in-memory store.
MONGO_URL=mongodb://localhost:27017
DB_NAME=juryai
